---
const githubRepo = 'https://github.com/wongkelvin1995-star/tztuijianbang.cc';
---

<div class="header-actions">
  <a class="search-link" href="/search/" aria-label="全文搜索">搜索 ⌕</a>
  <a class="tg-link" href="https://t.me/+EyjZtAEobDI5M2Jl" target="_blank" rel="sponsored nofollow noopener" aria-label="加入 Telegram 交流">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M21.8 3.2 18.5 20c-.25 1.18-.93 1.47-1.88.92l-5.2-3.83-2.51 2.41c-.28.28-.51.51-1.05.51l.37-5.29 9.63-8.7c.42-.37-.09-.57-.65-.2L5.3 13.27.18 11.67c-1.1-.34-1.12-1.1.23-1.6L20.45 2.4c.91-.34 1.71.22 1.35.8z"/></svg>
    <span>TG</span>
  </a>
  <a class="github-link" href={githubRepo} target="_blank" rel="noopener noreferrer" aria-label="梯子推荐榜 GitHub 仓库" title="GitHub 仓库">
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 .297a12 12 0 0 0-3.79 23.39c.6.111.82-.261.82-.577l-.016-2.234c-3.338.726-4.043-1.416-4.043-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.09-.745.082-.73.082-.73 1.205.084 1.84 1.237 1.84 1.237 1.07 1.834 2.807 1.304 3.492.997.108-.775.418-1.304.762-1.604-2.665-.304-5.466-1.332-5.466-5.93 0-1.31.469-2.381 1.235-3.22-.123-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23a11.5 11.5 0 0 1 6.008 0c2.292-1.552 3.297-1.23 3.297-1.23.655 1.652.243 2.873.12 3.176.77.839 1.233 1.91 1.233 3.22 0 4.61-2.804 5.622-5.475 5.921.43.372.823 1.102.823 2.222l-.012 3.293c0 .319.216.694.825.576A12.005 12.005 0 0 0 24 12.297c0-6.627-5.373-12-12-12"/></svg>
    <span>GitHub</span>
  </a>
</div>

<style>
  .github-link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 9px 11px;
    border: 1px solid var(--line);
    border-radius: 5px;
    color: var(--text);
    font-size: 12px;
    font-weight: 700;
    line-height: 1;
    white-space: nowrap;
  }

  .github-link svg {
    width: 14px;
    height: 14px;
    flex: none;
  }

  .github-link:hover {
    border-color: var(--blue);
    background: rgba(0, 212, 255, 0.08);
    color: var(--blue);
  }

  @media (max-width: 760px) {
    .github-link {
      padding: 8px 9px;
    }

    .github-link svg {
      width: 13px;
      height: 13px;
    }

    .github-link span {
      display: none;
    }
  }
</style>
