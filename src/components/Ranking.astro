---
import {airports,cheapest,money,payment,traffic} from '../data/airports';
import {rankingDisclosure} from '../data/ranking';
---
<div class="disclosure">{rankingDisclosure}</div><div class="rank-list">{airports.map(a=>{const low=cheapest(a),month=cheapest(a,1),year=cheapest(a,12),once=cheapest(a,0);return <div class="rank-row" data-airport-id={a.id}><span class="rank-no">{String(a.rank).padStart(2,'0')}</span><div class="rank-brand"><h3><a href={a.reviewUrl}>{a.name}</a></h3>{a.aliases.length>0&&<span class="alias">{a.aliases.join(' · ')}</span>}<p class="rank-summary">{a.summary}</p></div><div class="rank-prices">{low&&<><strong>{money(low)} / {payment(low)}</strong><span>{low.name}</span>{traffic(low)&&<span>{traffic(low)}</span>}{low.trafficGB===null&&low.note&&<span>{low.note}</span>}</>}{month&&year&&<span class="cycle-alternative">年付起 {money(year)} / 年 {traffic(year)&&` · ${traffic(year)}`}</span>}{once&&<span class="cycle-alternative">总量包起 {money(once)} / 次 {traffic(once)&&` · ${traffic(once)}`}</span>}</div><div class="rank-route">{a.routes.length>0&&<span>线路说明<br/><b>{a.routes.join(' · ')}</b></span>}{a.protocols.length>0&&<span class="muted">{a.protocols.join(' · ')}</span>}<span class="muted">{a.supportedClients}</span></div><a class="text-link review-link" href={a.reviewUrl}>机场测评 ↗</a></div>})}</div>
