---
import Base from '../layouts/Base.astro';
---
<Base title="中文全文搜索｜梯子推荐榜" description="搜索机场名称、套餐比较、线路分析与客户端教程。" noindex><section class="wrap section"><div class="eyebrow">SEARCH / KNOWLEDGE INDEX</div><h1>找到你的比较线索。</h1><p class="muted">搜索文章全文、机场中英文名与教程。试试“流量”“LadderCloud”或“订阅”。</p><form class="search-form" id="search-form" role="search"><label class="skip" for="query">搜索关键词</label><input type="search" id="query" name="q" placeholder="输入中文关键词或机场名称" autocomplete="off" required/><button type="submit">搜索</button></form><p id="search-status" role="status" aria-live="polite"></p><div id="search-results"></div></section><script is:inline type="module">
import {mergeSearchResults} from '/search-merge.js';
let brandsPromise;
const form=document.querySelector('#search-form'),input=document.querySelector('#query'),status=document.querySelector('#search-status'),out=document.querySelector('#search-results');let seq=0;
async function search(q){const current=++seq;out.replaceChildren();if(!q.trim()){status.textContent='请输入搜索关键词。';return;}status.textContent='正在搜索…';try{const pf=await import('/pagefind/pagefind.js');await pf.options({excerptLength:25});const result=await pf.search(q);const fulltext=await Promise.all(result.results.slice(0,30).map(r=>r.data()));brandsPromise??=fetch('/brand-search.json').then(r=>{if(!r.ok)throw new Error('Brand index unavailable');return r.json();});const brands=await brandsPromise;const data=mergeSearchResults(q,brands,fulltext);if(current!==seq)return;const count=result.results.length+data.filter(r=>!fulltext.some(f=>f.url===r.url)).length;status.textContent=`找到 ${count} 条结果${count>30?'，显示前30条':''}`;for(const r of data.slice(0,30)){const box=document.createElement('article');box.className='search-result';const a=document.createElement('a');a.href=r.url;const h=document.createElement('h2');h.textContent=r.meta.title||r.url;a.append(h);const p=document.createElement('p');p.textContent=r.excerpt.replace(/<[^>]*>/g,'');box.append(a,p);out.append(box);}}catch(e){if(current===seq)status.textContent='搜索索引尚未就绪。请先执行 npm run build，并使用 npm run preview 预览构建产物。';}}
form.addEventListener('submit',e=>{e.preventDefault();history.replaceState(null,'','?q='+encodeURIComponent(input.value));search(input.value);});const q=new URLSearchParams(location.search).get('q');if(q){input.value=q;search(q);}
</script></Base>
