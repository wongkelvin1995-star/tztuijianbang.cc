---
import Base from '../layouts/Base.astro';import Ranking from '../components/Ranking.astro';import Prices from '../components/Prices.astro';import HomeGuide from '../components/HomeGuide.astro';import {getCollection} from 'astro:content';import {faqGroups} from '../data/faq';
const posts=await getCollection('articles');const featured=['read-ranking','traffic-cost','line-labels','important-metrics','before-purchase','clash-import'];const guides=featured.map(id=>posts.find(a=>a.id===id)!).filter(Boolean);const tutorials=posts.filter(a=>a.data.category==='tutorials').slice(0,4);
---
<Base><section class="hero"><div class="wrap hero-grid"><div><div class="eyebrow">AIRPORT RANKING LAB / 2026 EDITION</div><h1>梯子推荐榜<span style="color:var(--blue)">｜</span><br/>机场排名、套餐对比<br/>与节点线路分析</h1><p>用清晰的数据和标准，读懂每一种选择。我们围绕价格、流量、节点线路及可追溯资料比较机场服务，整理机场测评与科学上网教程。榜单是编辑展示顺序，可能受合作关系影响；参考报价保留完整付款周期，不以名次代替测量。</p><div class="hero-actions"><a class="btn primary" href="#ranking">查看编辑排行榜 ↗</a><a class="btn" href="#guide">先读比较指南 ↓</a><a class="btn" href="https://t.me/+EyjZtAEobDI5M2Jl" target="_blank" rel="sponsored nofollow noopener">Telegram交流 ↗</a></div><p class="source">编辑收录 29 家 · 套餐按公开资料比较 · 排序依据公开</p></div><div class="lab" aria-label="资料比较示意，不代表测速成绩"><div class="lab-top"><span>COMPARISON SYSTEM</span><span>● EDITORIAL</span></div><div class="lab-orbit"><span class="orbit-core">29</span></div><div class="lab-labels"><span>价格 / 流量</span><span>路径 / 地区</span><span>来源 / 条件</span></div><p class="source">先核验每个字段，再建立自己的选择。</p></div></div></section><div class="wrap"><section class="section reveal"><div class="section-head"><div><span class="eyebrow">01 / THE COMPARISON FRAMEWORK</span><h2>四个维度，把选择变清楚。</h2></div><a class="text-link" href="/about/">比较标准 ↗</a></div><div class="metrics"><div class="metric"><b>价格 × 周期</b><p>看实付金额，区分月付与年付折算。</p></div><div class="metric"><b>流量 × 规则</b><p>额度、重置日、倍率一起核对。</p></div><div class="metric"><b>线路 × 场景</b><p>入口、路径、出口和目标服务分开看。</p></div><div class="metric"><b>证据 × 时间</b><p>来源可回溯，缺失资料明确留空。</p></div></div></section><section class="section reveal" id="ranking"><div class="section-head"><div><span class="eyebrow">02 / EDITORIAL SELECTION</span><h2>编辑推荐排行榜</h2><p>29家机场，同一份品牌数据库与比较条件。</p></div><a class="text-link" href="/ranking/">阅读榜单方法 ↗</a></div><Ranking/></section><HomeGuide/><section class="section reveal" id="pricing"><div class="section-head"><div><span class="eyebrow">03 / PLANS & COST</span><h2>机场价格对比</h2><p>让付款周期和可用额度回到同一张表。</p></div><a class="text-link" href="/pricing/">套餐比较专题 ↗</a></div><Prices/></section><section class="section reveal"><div class="section-head"><div><span class="eyebrow">04 / ROUTE ANATOMY</span><h2>读懂线路，也读懂节点。</h2></div><a class="text-link" href="/network/">线路知识 ↗</a></div><div class="split"><div class="panel"><span class="number-label">PATH / 入口 → 中转 → 出口 → 目标</span><h3>标签只是比较的起点</h3><p class="muted">IPLC、IEPL和中转描述不同的线路交付或路径特征。哪一段采用该线路、实际容量和出口路径，需要来源支持。</p><a class="text-link" href="/network/line-labels/">线路标签怎样核验 ↗</a></div><div class="panel"><span class="number-label">REGION / HK · JP · SG · US</span><h3>地区，要匹配你的应用</h3><p class="muted">出口地区、延迟和应用兼容是独立条件。节点名称不能证明真实地理位置，更不能保证平台长期可用。</p><a class="text-link" href="/network/region-choice/">节点地区怎么选 ↗</a></div></div></section><section class="section reveal"><div class="section-head"><div><span class="eyebrow">05 / MEASUREMENTS & SOURCES</span><h2>测速资料，从条件开始。</h2><p>当前没有真实成绩。这里提供指标解读与记录规范。</p></div><a class="text-link" href="/speed-tests/">测速方法 ↗</a></div><div class="metrics"><div class="metric"><b>延迟 / ms</b><p>说明探测方法、目标和样本数。</p></div><div class="metric"><b>吞吐 / Mbps</b><p>区分方向、线程和有效时长。</p></div><div class="metric"><b>丢包 / %</b><p>结合终点及业务请求判断。</p></div><div class="metric"><b>稳定 / 时间窗</b><p>重复取样，避免单次峰值。</p></div></div><p class="source">技术来源：<a href="https://www.cloudflare.com/en-gb/learning/performance/glossary/what-is-latency/" target="_blank" rel="noopener noreferrer">Cloudflare 延迟概念</a> · <a href="https://www.cloudflare.com/learning/network-layer/what-is-mtr/" target="_blank" rel="noopener noreferrer">MTR探测的解释边界</a>。这些来源说明技术方法，不构成本榜单机场的实测证据。</p></section><section class="section reveal"><div class="section-head"><div><span class="eyebrow">06 / DEEPER DECISIONS</span><h2>独立分析，让比较更具体。</h2></div><a class="text-link" href="/archives/">全部文章 ↗</a></div><div class="article-list">{guides.map(a=><a class="article-link" href={`/${a.data.category}/${a.id}/`}><span class="article-meta">DECISION NOTES</span><h3>{a.data.title}</h3><p>{a.data.description}</p><span class="text-link">深入阅读 ↗</span></a>)}</div></section><section class="section reveal"><div class="section-head"><div><span class="eyebrow">07 / CLIENT WORKFLOW</span><h2>客户端教程</h2><p>围绕安装来源、配置格式和验证步骤组织。</p></div><a class="text-link" href="/tutorials/">教程目录 ↗</a></div><div class="article-list">{tutorials.map(a=><a class="article-link" href={`/${a.data.category}/${a.id}/`}><h3>{a.data.title}</h3><p>{a.data.description}</p><span class="text-link">查看操作指南 ↗</span></a>)}</div></section><section class="section"><div class="section-head"><div><span class="eyebrow">08 / FREQUENT QUESTIONS</span><h2>选择之前，先解答几个问题。</h2></div><a class="text-link" href="/faq/">全部100个问题 ↗</a></div>{[faqGroups[1].items[0],faqGroups[2].items[1],faqGroups[4].items[0],faqGroups[8].items[0]].map(f=><div class="faq-item"><h3>{f.question}</h3><p>{f.answer}</p></div>)}</section></div></Base>
