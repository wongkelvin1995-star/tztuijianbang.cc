---
import Base from '../layouts/Base.astro';import {getCollection} from 'astro:content';import {airports} from '../data/airports';import {categories} from '../data/categories';
const posts=(await getCollection('articles')).sort((a,b)=>a.data.category!==b.data.category?a.data.category.localeCompare(b.data.category):a.data.category==='reviews'?(airports.find(x=>x.id===a.id)?.rank??99)-(airports.find(x=>x.id===b.id)?.rank??99):a.id.localeCompare(b.id));
---
<Base title="文章归档与专题目录｜梯子推荐榜" description="按排行榜、价格、节点测速、线路知识与客户端教程浏览本站全部文章。"><section class="wrap section"><span class="eyebrow">LIBRARY / ALL NOTES</span><h1>文章归档</h1><p class="muted">{posts.length}篇独立内容 · 100个常见问题 · 以比较意图组织专题</p><nav class="category-nav" aria-label="专题目录">{categories.map(c=><a href={`#${c.slug}`}>{c.name}</a>)}<a href="/faq/">常见问题</a><a href="/about/">关于本站</a></nav>{categories.map(c=><section class="section" id={c.slug}><div class="section-head"><h2>{c.name}</h2><a class="text-link" href={`/${c.slug}/`}>栏目首页 ↗</a></div><div class="article-list">{posts.filter(a=>a.data.category===c.slug).map(a=><a class="article-link" href={`/${c.slug}/${a.id}/`}><h3>{a.data.title}</h3><p>{a.data.description}</p></a>)}</div></section>)}</section></Base>
