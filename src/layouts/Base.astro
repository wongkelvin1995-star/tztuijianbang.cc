---
import '../styles/global.css';
import {seo} from '../data/seo-profile';
import {categories} from '../data/categories';
import HeaderActions from '../components/HeaderActions.astro';
interface Props {title?:string;description?:string;article?:{title:string;date:Date;updated?:Date};noindex?:boolean;}
const {title=seo.title,description=seo.description,article,noindex=false}=Astro.props;
const canonical=new URL(Astro.url.pathname==='/404/'?'/404.html':Astro.url.pathname,seo.site).href;
const schema=article?{'@context':'https://schema.org','@type':'Article',headline:article.title,datePublished:article.date.toISOString(),...(article.updated?{dateModified:article.updated.toISOString()}:{}),author:{'@type':'Organization',name:seo.name},publisher:{'@type':'Organization',name:seo.name},mainEntityOfPage:canonical}:{'@context':'https://schema.org','@type':'WebSite',name:seo.name,url:seo.site};
const parts=Astro.url.pathname.split('/').filter(Boolean);
const crumbs=[{name:'首页',url:seo.site+'/'},...parts.map((part,i)=>({name:categories.find(c=>c.slug===part)?.name||(i===parts.length-1?title.split('｜')[0]:part),url:seo.site+'/'+parts.slice(0,i+1).join('/')+'/'}))];
---
<!doctype html><html lang="zh-CN"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#070B16"/><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/>{noindex&&<meta name="robots" content="noindex,follow"/>}<meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content={article?'article':'website'}/><meta property="og:url" content={canonical}/><meta property="og:image" content={seo.site+'/og.png'}/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={seo.site+'/og.png'}/><meta property="og:locale" content="zh_CN"/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><link rel="alternate" type="application/rss+xml" title="梯子推荐榜 RSS" href="/rss.xml"/><script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g,'\\u003c')}/>{parts.length>0&&<script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:crumbs.map((c,i)=>({'@type':'ListItem',position:i+1,name:c.name,item:c.url}))}).replace(/</g,'\\u003c')}/>}</head><body><a class="skip" href="#main">跳到正文</a><header class="site-header"><div class="header-inner"><a class="brand" href="/"><span class="brand-icon">↗</span><span>梯子推荐榜<small>AIRPORT RANKING LAB</small></span></a><button id="menu-toggle" aria-expanded="false" aria-controls="navigation">栏目 ☰</button><nav id="navigation" aria-label="主导航"><a href="/ranking/">排行榜</a><a href="/reviews/">机场测评</a><a href="/pricing/">价格对比</a><a href="/speed-tests/">节点测速</a><a href="/tutorials/">客户端教程</a><a href="/archives/">所有栏目</a></nav><HeaderActions/></div></header><main id="main" data-pagefind-body={!noindex ? true : undefined} data-pagefind-ignore={noindex ? true : undefined}>{parts.length>0&&<nav class="breadcrumbs wrap" aria-label="面包屑">{crumbs.map((c,i)=><>{i<crumbs.length-1?<a href={new URL(c.url).pathname}>{c.name}</a>:<span aria-current="page">{c.name}</span>}{i<crumbs.length-1&&<span>/</span>}</>)}</nav>}<slot/></main><footer data-pagefind-ignore><div class="wrap footer-grid"><div><a class="brand" href="/">梯子推荐榜</a><p>用清晰的数据和标准，读懂每一种选择。</p><p class="muted">围绕机场测评、套餐对比、节点测速与线路分析，提供可追溯的技术资料及客户端教程。我们披露编辑排序与AFF合作，核验后更新事实；缺失资料明确留空。</p></div><div><h3>探索栏目</h3>{categories.map(c=><a href={`/${c.slug}/`}>{c.name}</a>)}</div><div><h3>编辑与资料</h3><a href="/about/">关于本站 / 合作披露</a><a href="/faq/">常见问题</a><a href="/archives/">文章归档</a><a href="/safety/">机场避坑指南</a><a href="/rss.xml">RSS订阅</a><a href="https://t.me/+EyjZtAEobDI5M2Jl" target="_blank" rel="sponsored nofollow noopener">Telegram交流 ↗</a><button id="motion-toggle" aria-pressed="false">减少动态效果</button></div></div><div class="wrap copyright">© 2026 梯子推荐榜 · 独立编辑资料站 · 不提供未经核验的性能承诺</div></footer><script>
const root=document.documentElement;const motion=document.querySelector<HTMLButtonElement>('#motion-toggle');
function setMotion(reduced:boolean){root.classList.toggle('reduce-motion',reduced);motion?.setAttribute('aria-pressed',String(reduced));if(motion)motion.textContent=reduced?'恢复动态效果':'减少动态效果';}
try{setMotion(localStorage.getItem('reduced-motion')==='1');}catch{}
motion?.addEventListener('click',()=>{const value=!root.classList.contains('reduce-motion');setMotion(value);try{localStorage.setItem('reduced-motion',value?'1':'0');}catch{}});
const menu=document.querySelector<HTMLButtonElement>('#menu-toggle');menu?.addEventListener('click',()=>{const open=menu.getAttribute('aria-expanded')!=='true';menu.setAttribute('aria-expanded',String(open));document.querySelector('#navigation')?.classList.toggle('open',open);});
if('IntersectionObserver' in window&&!matchMedia('(prefers-reduced-motion: reduce)').matches){const observer=new IntersectionObserver(entries=>entries.forEach(e=>{if(e.isIntersecting){e.target.classList.add('visible');observer.unobserve(e.target);}}),{threshold:0.04});document.querySelectorAll('.reveal').forEach(el=>observer.observe(el));}
</script></body></html>
